# ==============================================================================
# Netlink Cogni - Environment Variables Configuration Template
# ==============================================================================
# NOTE: Variables prefixed with NEXT_PUBLIC_ are bundled into client-side JS and
# are readable by any browser. NEVER put secrets or private keys in NEXT_PUBLIC_ vars.
# All private keys and service credentials must stay strictly server-side.
# ==============================================================================

# ================================
# 1. Supabase (Database & Auth)
# ================================
# [REACHES BROWSER: YES] Public Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# [REACHES BROWSER: YES] Public Anon key (safe for browser; protected by Row Level Security)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# [REACHES BROWSER: NO] SERVER SECRET: Full administrative database bypass key
# NEVER expose to client or prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ================================
# 2. Firebase Auth (Optional Bridge)
# ================================
# [REACHES BROWSER: YES] Firebase Web API keys (Client SDK configuration)
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your-measurement-id

# Optional Firebase Data Connect flags
# NEXT_PUBLIC_FIREBASE_DATACONNECT_ENABLED=true
# NEXT_PUBLIC_FIREBASE_DATACONNECT_EMULATOR=false

# ================================
# 3. Application URLs
# ================================
# [REACHES BROWSER: YES] Canonical public application URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ================================
# 4. Admin Portal Security
# ================================
# [REACHES BROWSER: NO] SERVER SECRET: Admin dashboard authentication credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-super-secure-admin-password
ADMIN_SECRET=your-random-32-char-hmac-secret-key

# ================================
# 5. AI Providers (Server-Side Only)
# ================================
# [REACHES BROWSER: NO] SERVER SECRET: Primary provider for text & vision tasks
OPENAI_API_KEY=sk-proj-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini

# [REACHES BROWSER: NO] SERVER SECRET: First fallback provider
GEMINI_API_KEY=your-google-gemini-api-key

# [REACHES BROWSER: NO] SERVER SECRET: Second fallback provider (rotated models)
OPENROUTER_API_KEY=sk-or-your-openrouter-api-key

# [REACHES BROWSER: NO] SERVER SECRET: Third fallback provider
BYTEZ_API_KEY=your-bytez-api-key

# ================================
# 6. Voice & Conversational AI (ElevenLabs)
# ================================
# [REACHES BROWSER: NO] SERVER SECRET: ElevenLabs API Key used by server routes (/api/elevenlabs-*)
ELEVENLABS_API_KEY=your-elevenlabs-api-key
# [REACHES BROWSER: NO] Server-side default Agent ID for conversational AI
ELEVENLABS_AGENT_ID=your-elevenlabs-agent-id
# [REACHES BROWSER: YES] Optional public agent ID for direct client WebRTC connection
# NEXT_PUBLIC_ELEVENLABS_AGENT_ID=your-elevenlabs-agent-id

# ================================
# 7. Google OAuth & Calendar Integration
# ================================
# [REACHES BROWSER: NO*] Google OAuth Client ID (Public in OAuth redirect URLs, but managed on server)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# [REACHES BROWSER: NO] SERVER SECRET: Google OAuth Client Secret for token exchange
GOOGLE_CLIENT_SECRET=your-google-client-secret
# [REACHES BROWSER: NO] Authorized OAuth redirect URI
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google-calendar/callback
# [REACHES BROWSER: NO] SERVER SECRET: Protects background sync cron endpoints
CRON_SECRET=your-cron-secret-token

# ================================
# 8. PayPal Payments & Subscriptions
# ================================
# [REACHES BROWSER: YES (via API route)] Public PayPal Client ID (required for PayPal Buttons SDK)
PAYPAL_CLIENT_ID=your-paypal-client-id
# [REACHES BROWSER: NO] SERVER SECRET: PayPal Client Secret for server-side capture
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
# [REACHES BROWSER: NO] PayPal environment mode: 'sandbox' or 'live'
PAYPAL_ENVIRONMENT=sandbox
# [REACHES BROWSER: YES] Default PayPal Plan ID for subscriptions
NEXT_PUBLIC_PAYPAL_PLAN_ID=your-paypal-plan-id

# ================================
# 9. SMTP & Email Delivery (Nodemailer)
# ================================
# [REACHES BROWSER: NO] SMTP server configuration (server-side only)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
# [REACHES BROWSER: NO] SERVER SECRET: SMTP password or 16-character Google App Password
SMTP_PASS=your-16-char-app-password
SMTP_FROM="Netlink AI <your-email@gmail.com>"
# Admin notification inbox
ADMIN_EMAIL=your-email@gmail.com
