# ================================
# Supabase
# ================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ================================
# Firebase Auth (sign-in / sign-up; data stays in Supabase)
# ================================
# When set, email/password and Google use Firebase, then sync to Supabase session.
# Enable Email/Password + Google in Firebase Console → Authentication → Sign-in method.
# Add Third-Party Auth → Firebase in Supabase Dashboard (project ID: netl-bf0f1).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Data Connect is optional (Supabase remains primary). Enable only after deploy or with emulators.
# NEXT_PUBLIC_FIREBASE_DATACONNECT_ENABLED=true
# NEXT_PUBLIC_FIREBASE_DATACONNECT_EMULATOR=true

# ================================
# App
# ================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ================================
# SMTP (Nodemailer — system emails, auth notifications, waitlist)
# ================================
# Gmail example: host smtp.gmail.com, port 587, use App Password (not regular password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="Netlink AI <your-email@gmail.com>"

# Legacy fallbacks (optional if SMTP_* is set)
# GMAIL_USER=
# GMAIL_APP_PASSWORD=

# Admin inbox for quotation requests (defaults to SMTP_USER)
# ADMIN_EMAIL=

# Protects bulk waitlist notify endpoint and admin RPC fallback
# ADMIN_SECRET=

# Required for admin dashboard (Supabase → Project Settings → API → service_role)
# SUPABASE_SERVICE_ROLE_KEY is listed above with other Supabase keys
