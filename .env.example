# ================================
# Supabase
# ================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ================================
# App
# ================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ================================
# SMTP (Nodemailer — system emails, auth notifications, waitlist)
# ================================
# Gmail example: host smtp.gmail.com, port 587, use App Password (not regular password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="Netlink AI <your-email@gmail.com>"

# Legacy fallbacks (optional if SMTP_* is set)
# GMAIL_USER=
# GMAIL_APP_PASSWORD=

# Admin inbox for quotation requests (defaults to SMTP_USER)
# ADMIN_EMAIL=

# Protects bulk waitlist notify endpoint
# ADMIN_SECRET=
